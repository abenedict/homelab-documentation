# SSH config used by Claude for homelab access.
# Usage: ssh -F /home/abenedict/claude/ssh/config <host-alias>
# Add one Host block per server as they're onboarded (see docs/hosts/).

# Must come before Host * so its key is offered first (GitHub accepts the first key that authenticates).
# GitHub deploy key for the homelab-iac repo (GitHub requires a unique deploy key per repo).
# Use as remote: git@github-iac:ploopyfloofee/homelab-iac.git (private; owned by the ploopyfloofee account)
Host github-iac
    HostName github.com
    User git
    IdentityFile /home/abenedict/claude/ssh/claude_iac_github_ed25519

Host *
    IdentityFile /home/abenedict/claude/ssh/claude_homelab_ed25519
    IdentitiesOnly yes
    UserKnownHostsFile /home/abenedict/claude/ssh/known_hosts
    StrictHostKeyChecking accept-new
    ServerAliveInterval 30
    ConnectTimeout 10

# Example:
# Host nas
#     HostName 192.168.1.10
#     User admin

Host oracle1
    HostName 129.80.178.38
    User ubuntu

Host opnsense
    HostName 192.168.1.1
    User claude
